#include "resource.h"

IDI_APP_ICON ICON "speed roll.ico"

1 VERSIONINFO
 FILEVERSION 1,0,4,0
 PRODUCTVERSION 1,0,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "speed roll"
            VALUE "FileDescription", "speed roll - lightweight mouse wheel enhancer"
            VALUE "FileVersion", "1.0.4.0"
            VALUE "InternalName", "speed roll"
            VALUE "LegalCopyright", "Copyright (C) 2026 dogjayaa"
            VALUE "OriginalFilename", "speed roll.exe"
            VALUE "ProductName", "speed roll"
            VALUE "ProductVersion", "1.0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
